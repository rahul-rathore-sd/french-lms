# ==============================================================================
# Académie de Français - environment template
# Copy to `.env.local` for local development. NEVER commit real values.
# On Render, set these under Environment -> Environment Variables.
# ==============================================================================

# Clerk authentication (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk webhook signing secret (Dashboard -> Webhooks -> endpoint)
CLERK_WEBHOOK_SECRET=whsec_...

# Resend (welcome emails)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# Public site URL used in emails
NEXT_PUBLIC_SITE_URL=https://your-app.onrender.com

# Comma-separated admin emails allowed into /admin (or set Clerk
# publicMetadata {"role":"admin"} on the user instead)
ADMIN_EMAILS=you@example.com

# Bearer token for the Hermes ingestion endpoint (POST /api/v1/vocabulary).
# REQUIRED to enable ingestion. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HERMES_API_KEY=

# PostgreSQL connection string (Render Postgres, Neon, Supabase, ...).
# Stores applications and ingested words. Tables are created automatically.
# Leave empty to use in-memory storage (data is lost on restart).
# Use Render's *Internal* URL when the app runs on Render; set DATABASE_SSL=false
# only if your provider does not use TLS.
DATABASE_URL=
