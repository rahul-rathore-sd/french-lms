# ==============================================================================
# Académie de Français - Environment Configuration Template
# Duplicate this file to '.env.local' and supply your valid API credentials.
# NOTE: '.env.local' is git-ignored and will never be committed to repository.
# ==============================================================================

# 1. Clerk Authentication (Free Tier Consumer Mode)
# Obtained from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URL redirects for Next.js App Router custom auth pages
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# 2. Clerk Webhook Secret (for verifying svix signature in /api/webhooks/clerk)
# Obtained from Clerk Dashboard -> Webhooks -> Add Endpoint -> Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# 3. Resend API Key (for sending Welcome Email on user.created)
# Obtained from https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# 4. Hermes Autonomous Agent Ingestion Key
# Secret token for external automated cron/agent updates
HERMES_API_KEY=hermes_classical_secure_token_2026
